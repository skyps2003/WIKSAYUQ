# =============================================================================
# WIKSAYUQ — Backend Environment Variables (development)
# =============================================================================
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a git (ya está en .gitignore).

NODE_ENV=development
PORT=3000

# --- Base de datos ---
# Conexión Pooler de Supabase (Transaction mode — puerto 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:CAMBIAR_PASSWORD@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión Directa (Session mode — puerto 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:CAMBIAR_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# --- Auth ---
JWT_ACCESS_SECRET=super_secret_access_123
JWT_REFRESH_SECRET=super_secret_refresh_456
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGINS=http://localhost:8081,http://192.168.18.50:8081

# --- Supabase (opcional, para features que usan Supabase JS SDK) ---
SUPABASE_URL=https://ujqikgbedxliecygksas.supabase.co
SUPABASE_ANON_KEY=poner_tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=

# --- Límites ---
MAX_BASE64_IMAGE_MB=2
