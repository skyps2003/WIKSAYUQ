  autoevaluaciones         autoevaluaciones?     @relation(fields: [autoevaluacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  citas                    citas?                @relation(fields: [cita_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  controles_prenatales     controles_prenatales? @relation(fields: [control_prenatal_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  embarazos                embarazos             @relation(fields: [embarazo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notificaciones           notificaciones[]

  @@index([atendida_por])
  @@index([autoevaluacion_id])
  @@index([control_prenatal_id])
  @@index([embarazo_id])
  @@index([estado])
  @@index([fecha_generacion])
  @@index([nivel])
}

