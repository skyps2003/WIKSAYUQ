generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model auth_users {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String?   @unique @db.VarChar(150)
  phone              String?   @unique @db.VarChar(20)
  encrypted_password String?
  email_confirmed_at DateTime? @db.Timestamp(6)
  phone_confirmed_at DateTime? @db.Timestamp(6)
  last_sign_in_at    DateTime? @db.Timestamp(6)
  created_at         DateTime? @db.Timestamp(6)
  updated_at         DateTime? @db.Timestamp(6)
  perfiles           perfiles?
}

model perfiles {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombres                   String                      @db.VarChar(100)
  apellido_paterno          String                      @db.VarChar(80)
  apellido_materno          String?                     @db.VarChar(80)
  tipo_documento            tipo_documento              @default(DNI)
  numero_documento          String                      @unique @db.VarChar(20)
  fecha_nacimiento          DateTime?                   @db.Date
  sexo                      sexo_usuario?               @default(NO_ESPECIFICA)
  telefono                  String?                     @db.VarChar(20)
  direccion                 String?
  idioma_preferido          idioma_usuario              @default(ESPANOL)
  rol                       rol_usuario
  estado                    estado_usuario              @default(ACTIVO)
  foto_url                  String?
  acepta_terminos           Boolean                     @default(false)
  acepta_tratamiento_datos  Boolean                     @default(false)
  fecha_aceptacion_datos    DateTime?                   @db.Timestamp(6)
  created_at                DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                DateTime                    @default(now()) @db.Timestamp(6)
  deleted_at                DateTime?                   @db.Timestamp(6)
  version                   Int                         @default(1)
  foto_base64               String?
  auditoria                 auditoria[]
  citas                     citas[]
  conflictos_sincronizacion conflictos_sincronizacion[]
  consejos                  consejos[]
  dispositivos              dispositivos[]
  embarazo_factores_riesgo  embarazo_factores_riesgo[]
  gestantes                 gestantes?
  notificaciones            notificaciones[]
  auth_users                auth_users                  @relation(fields: [id], references: [id], onDelete: Cascade, map: "fk_perfiles_auth_users")
  personal_salud            personal_salud?
  resultados_examenes       resultados_examenes[]
  sync_queue                sync_queue[]

  @@index([estado])
  @@index([rol])
  @@index([telefono])
}

model gestantes {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  perfil_id                String                  @unique @db.Uuid
  comunidad_id             String?                 @db.Uuid
  establecimiento_id       String?                 @db.Uuid
  codigo_gestante          String?                 @unique @db.VarChar(30)
  grado_instruccion        String?                 @db.VarChar(80)
  ocupacion                String?                 @db.VarChar(100)
  estado_civil             String?                 @db.VarChar(50)
  numero_hijos             Int                     @default(0)
  numero_embarazos_previos Int                     @default(0)
  numero_partos_previos    Int                     @default(0)
  numero_abortos_previos   Int                     @default(0)
  grupo_sanguineo          String?                 @db.VarChar(5)
  factor_rh                String?                 @db.VarChar(10)
  tiene_seguro             Boolean                 @default(false)
  tipo_seguro              String?                 @db.VarChar(50)
  numero_seguro            String?                 @db.VarChar(50)
  observaciones_generales  String?
  activo                   Boolean                 @default(true)
  created_at               DateTime                @default(now()) @db.Timestamp(6)
  updated_at               DateTime                @default(now()) @db.Timestamp(6)
  deleted_at               DateTime?               @db.Timestamp(6)
  version                  Int                     @default(1)
  asignaciones_gestante    asignaciones_gestante[]
  consejos_visualizados    consejos_visualizados[]
  contactos_emergencia     contactos_emergencia[]
  embarazos                embarazos[]
  eventos_sos              eventos_sos[]
  perfiles                 perfiles                @relation(fields: [perfil_id], references: [id], onDelete: Cascade, map: "fk_gestantes_perfiles")
  comunidades              comunidades?            @relation(fields: [comunidad_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  establecimientos_salud   establecimientos_salud? @relation(fields: [establecimiento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([activo])
  @@index([comunidad_id])
  @@index([establecimiento_id])
}

model personal_salud {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  perfil_id              String                  @unique @db.Uuid
  establecimiento_id     String                  @db.Uuid
  tipo_personal          tipo_personal_salud
  numero_colegiatura     String?                 @db.VarChar(30)
  especialidad           String?                 @db.VarChar(100)
  cargo                  String?                 @db.VarChar(100)
  fecha_ingreso          DateTime?               @db.Date
  activo                 Boolean                 @default(true)
  created_at             DateTime                @default(now()) @db.Timestamp(6)
  updated_at             DateTime                @default(now()) @db.Timestamp(6)
  deleted_at             DateTime?               @db.Timestamp(6)
  version                Int                     @default(1)
  alertas                alertas[]
  asignaciones_gestante  asignaciones_gestante[]
  citas                  citas[]
  controles_prenatales   controles_prenatales[]
  perfiles               perfiles                @relation(fields: [perfil_id], references: [id], onDelete: Cascade, map: "fk_personal_salud_perfiles")
  establecimientos_salud establecimientos_salud  @relation(fields: [establecimiento_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vacunas_gestante       vacunas_gestante[]

  @@index([establecimiento_id])
  @@index([numero_colegiatura])
  @@index([tipo_personal])
}

model conversaciones {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gestante_id       String     @db.Uuid
  personal_salud_id String     @db.Uuid
  activa            Boolean    @default(true)
  created_at        DateTime   @default(now()) @db.Timestamp(6)
  updated_at        DateTime   @default(now()) @db.Timestamp(6)
  deleted_at        DateTime?  @db.Timestamp(6)
  version           Int        @default(1)
  mensajes          mensajes[]

  @@index([gestante_id], map: "idx_conversaciones_gestante")
}

model mensajes {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversacion_id     String         @db.Uuid
  remitente_perfil_id String         @db.Uuid
  contenido           String
  leido               Boolean        @default(false)
  fecha_lectura       DateTime?      @db.Timestamp(6)
  created_at          DateTime       @default(now()) @db.Timestamp(6)
  updated_at          DateTime       @default(now()) @db.Timestamp(6)
  deleted_at          DateTime?      @db.Timestamp(6)
  version             Int            @default(1)
  conversacion        conversaciones @relation(fields: [conversacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([conversacion_id], map: "idx_mensajes_conversacion")
}

