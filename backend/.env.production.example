# Copy this file to .env on BanaHosting and replace every placeholder.
# Never place this file inside public_html or commit the completed .env.
NODE_ENV=production

# Supabase Session pooler (IPv4), normally port 5432.
DATABASE_URL="postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Generate two different random values of at least 64 bytes.
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=https://wiksayuq.rimaqmasi.com

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

MAX_BASE64_IMAGE_MB=2
